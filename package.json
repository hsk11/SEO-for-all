{
  "name": "seo-analyzer",
  "version": "1.0.0",
  "description": "Self-hosted SEO analyzer: crawl a website, audit on-page SEO, broken links, site structure, metadata, images and keyword density, and export Excel/PDF reports.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
